# Copie ce fichier en .env puis colle ta clé : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Optionnel ---
# PORT=3000
# HOST=0.0.0.0               # accès depuis le téléphone (même Wi-Fi)

# Préparation automatique de la journée (si l'app tourne, ex. lancée au démarrage)
# PREPARE_AT=05:00           # heure de préparation de la liste du jour
# PREGENERATE_ARTICLES=1     # rédige aussi les 6 articles à l'avance (plus cher : voir README)
# PREPARE=0                  # désactive complètement la préparation automatique

# TOPICS_MODEL=claude-haiku-5-5
# ARTICLE_MODEL=claude-opus-5-5
# ARTICLE_EFFORT=medium      # low | medium | high (qualité vs coût)
