{
  "name": "culture-quotidienne",
  "version": "1.0.0",
  "description": "Mini app web locale d’apprentissage quotidien (culture générale) générée avec Claude",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning server.js",
    "demo": "MOCK_AI=1 DB_PATH=data/demo.db node --no-warnings=ExperimentalWarning server.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js",
    "autostart:install": "node scripts/autostart.js install",
    "autostart:remove": "node scripts/autostart.js remove"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.3.0",
    "marked": "^18.1.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
